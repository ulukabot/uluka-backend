// lib/liquidity.js
async function checkLiquidity(bybit, symbol, tradeSide, currentPrice) {
  try {
    // Fetch top 50 levels of the order book
    const res = await fetch(`${bybit.baseUrl}/v5/market/orderbook?category=linear&symbol=${symbol}&limit=50`);
    const json = await res.json();
    
    if (!json.result || !json.result.b || !json.result.a) return true; // API failed, allow trade

    const bids = json.result.b; 
    const asks = json.result.a;

    let bidVol = 0;
    let askVol = 0;
    const range = currentPrice * 0.005; // 0.5% range around price

    bids.forEach(b => {
      if (parseFloat(b[0]) > currentPrice - range) bidVol += parseFloat(b[1]);
    });

    asks.forEach(a => {
      if (parseFloat(a[0]) < currentPrice + range) askVol += parseFloat(a[1]);
    });

    if (bidVol === 0 || askVol === 0) return true;

    const imbalance = bidVol / (bidVol + askVol); // 0.0 (all asks) to 1.0 (all bids)

    console.log(`📊 Liquidity ${symbol}: Imbalance ${(imbalance * 100).toFixed(1)}%`);

    // If buying, we want more bids (imbalance > 0.4). If selling, we want more asks (imbalance < 0.6)
    if (tradeSide === 'BUY' && imbalance < 0.40) return false; // Wall of sellers
    if (tradeSide === 'SELL' && imbalance > 0.60) return false; // Wall of buyers

    return true; 
  } catch (e) {
    console.error('Liquidity Check Error:', e.message);
    return true; // If error, allow trade
  }
}

module.exports = { checkLiquidity };
